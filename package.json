{
  "name": "rare-friends-mint",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "compile:genesis": "node scripts/compile-genesis-child.mjs",
    "build:genesis": "cargo build --release --locked --manifest-path rust-genesis-minter/Cargo.toml",
    "genesis": "rust-genesis-minter/target/release/vinos-genesis",
    "test:genesis": "cargo test --locked --manifest-path rust-genesis-minter/Cargo.toml --all-targets --all-features && cargo build --locked --manifest-path rust-genesis-minter/Cargo.toml && node --test test/genesis-child-evm.test.mjs test/genesis-child-fork.test.mjs test/rust-genesis-minter-evm.test.mjs",
    "mint": "node mint.mjs",
    "batch": "node batch.mjs",
    "launch": "node batch.mjs setup",
    "start": "node batch.mjs start",
    "launch:sequencer": "node batch.mjs setup --sequencer",
    "start:sequencer": "node batch.mjs start --sequencer",
    "benchmark": "node benchmark.mjs",
    "benchmark:sequencer": "node sequencer-benchmark.mjs",
    "benchmark:az": "node az-benchmark.mjs",
    "compile:benchmark": "node scripts/compile-benchmark.mjs",
    "compile:timed-benchmark": "node scripts/compile-timed-benchmark.mjs",
    "test:timed-benchmark": "node --test test/timed-benchmark-evm.test.mjs test/rust-timed-mint-evm.test.mjs",
    "inspect": "node mint.mjs --inspect --payload research/reference-transaction.json",
    "test": "node --test test/*.test.mjs",
    "compile:batch": "node scripts/compile-batch.mjs",
    "test:batch": "node scripts/simulate-batch.mjs",
    "test:race": "node scripts/simulate-race.mjs",
    "simulate:race": "node scripts/simulate-race-rpc.mjs",
    "simulate:rpc": "node scripts/simulate-rpc-batch.mjs"
  },
  "dependencies": {
    "ethers": "6.17.0"
  },
  "overrides": {
    "tmp": "0.2.7"
  },
  "devDependencies": {
    "solc": "0.8.26"
  }
}
